# Copia a apps/mobile/.env si necesitas forzar la URL de la API.
#
# Por defecto la app usa la IP del ordenador que ejecuta `expo start`
# y el puerto de abajo, así que en la misma red Wi-Fi no hace falta tocar nada.
# Defínela si usas `expo start --tunnel` o una API desplegada.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Puerto de la API en tu ordenador (el PORT de apps/api/.env)
EXPO_PUBLIC_API_PORT=3000
