# Copy to apps/mobile/.env to override how the app reaches the API.
#
# By default the app uses the IP of the machine running `expo start` and the
# port below, so nothing needs configuring on the same Wi-Fi network.
# Set the URL when using `expo start --tunnel` or a deployed API.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# API port on your machine (PORT in apps/api/.env)
EXPO_PUBLIC_API_PORT=3000
