### =====================================================================
### Manual API requests (VS Code "REST Client" extension)
###
### 1. Start the API: `pnpm docker:up`, then `pnpm dev`.
### 2. Click "Send Request" above each request, IN ORDER. Requests tagged
###    with "@name" store their response, and later requests reuse the
###    token / id / join code automatically.
###
### If you change PORT in apps/api/.env, change @baseUrl too.
### =====================================================================

@baseUrl = http://localhost:3000
@password = correct-horse-battery


### ---------------------------------------------------------------------
### 0. Health
### ---------------------------------------------------------------------

GET {{baseUrl}}/health


### ---------------------------------------------------------------------
### 1. Users (first run: register; afterwards they return 409, just log in)
### ---------------------------------------------------------------------

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "demo_hunter",
  "email": "demo_hunter@demo.manhunt",
  "password": "{{password}}",
  "acceptTerms": true
}

###

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "demo_runner",
  "email": "demo_runner@demo.manhunt",
  "password": "{{password}}",
  "acceptTerms": true
}

###

# @name hunter
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "identifier": "demo_hunter", "password": "{{password}}" }

###

# @name runner
POST {{baseUrl}}/auth/login
Content-Type: application/json

# The email works too: "demo_runner@demo.manhunt"
{ "identifier": "demo_runner", "password": "{{password}}" }

###

@hunterToken = {{hunter.response.body.accessToken}}
@runnerToken = {{runner.response.body.accessToken}}
@runnerId = {{runner.response.body.user.id}}

GET {{baseUrl}}/auth/me
Authorization: Bearer {{hunterToken}}


### ---------------------------------------------------------------------
### 2. Lobby
### ---------------------------------------------------------------------

# Is there an open match already? You can only be in one at a time:
# close it with "Close the lobby" below, or wait until it ends.
GET {{baseUrl}}/matches/current
Authorization: Bearer {{hunterToken}}

###

# @name createMatch
POST {{baseUrl}}/matches
Authorization: Bearer {{hunterToken}}
Content-Type: application/json

{
  "playArea": { "lat": 41.387, "lng": 2.17, "radiusMeters": 400 },
  "hidingSeconds": 10,
  "durationSeconds": 120,
  "pingIntervalSeconds": 15
}

###

@matchId = {{createMatch.response.body.id}}
@joinCode = {{createMatch.response.body.joinCode}}

POST {{baseUrl}}/matches/join
Authorization: Bearer {{runnerToken}}
Content-Type: application/json

{ "joinCode": "{{joinCode}}" }

###

GET {{baseUrl}}/matches/{{matchId}}
Authorization: Bearer {{runnerToken}}

###

# Change a player's team (host only): "HUNTER" or "RUNNER".
PATCH {{baseUrl}}/matches/{{matchId}}/players/{{runnerId}}
Authorization: Bearer {{hunterToken}}
Content-Type: application/json

{ "team": "RUNNER" }

###

# Start: WAITING -> HIDING (and ACTIVE 10 s later)
POST {{baseUrl}}/matches/{{matchId}}/start
Authorization: Bearer {{hunterToken}}

###

# Watch status / hidingEndsAt / endsAt change
GET {{baseUrl}}/matches/{{matchId}}
Authorization: Bearer {{hunterToken}}

###

# Close the lobby (only BEFORE the match starts)
DELETE {{baseUrl}}/matches/{{matchId}}
Authorization: Bearer {{hunterToken}}


### ---------------------------------------------------------------------
### 3. Expected errors
### ---------------------------------------------------------------------

# 401 UNAUTHORIZED: no token
GET {{baseUrl}}/matches/current

###

# 400 VALIDATION_ERROR, with per-field "details"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "username": "a", "email": "not-an-email", "password": "1", "acceptTerms": false }

###

# 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "identifier": "demo_hunter", "password": "wrong-password" }

###

# 404 MATCH_NOT_FOUND
POST {{baseUrl}}/matches/join
Authorization: Bearer {{runnerToken}}
Content-Type: application/json

{ "joinCode": "ZZZZZZ" }

###

# 403 NOT_HOST: the runner tries to start the match
POST {{baseUrl}}/matches/{{matchId}}/start
Authorization: Bearer {{runnerToken}}

###

# 400: the id is not a UUID
GET {{baseUrl}}/matches/not-a-uuid
Authorization: Bearer {{hunterToken}}


### ---------------------------------------------------------------------
### 4. Logging out (run last: log in again with section 1 afterwards)
### ---------------------------------------------------------------------

# 204: the hunter's token stops working and its sockets are closed
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{hunterToken}}

###

# 401 UNAUTHORIZED: the same token, after logging out
GET {{baseUrl}}/auth/me
Authorization: Bearer {{hunterToken}}

###

# 204: ends every session of the runner, on every device
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{runnerToken}}

### ---------------------------------------------------------------------
### The real-time part (positions, pings, catches) runs over WebSocket and
### can't be exercised from here. Use: pnpm --filter @manhunt/api simulate
### ---------------------------------------------------------------------
