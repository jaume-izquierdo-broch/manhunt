# Copy to apps/api/.env for local development (`pnpm dev`).
NODE_ENV=development
PORT=3000

# Use the port from DB_PORT in the root .env if you changed it.
DATABASE_URL=postgresql://manhunt:manhunt_secret@localhost:5432/manhunt_db
RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# At least 16 characters.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN_SECONDS=604800

CORS_ORIGIN=*

# Game rules
CATCH_RADIUS_METERS=25
POSITION_MAX_AGE_SECONDS=30
