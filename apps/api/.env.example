# Copia a apps/api/.env para desarrollo local (pnpm dev).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://manhunt:manhunt_secret@localhost:5432/manhunt_db
RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Mínimo 16 caracteres
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN_SECONDS=604800

CORS_ORIGIN=*

# Reglas de juego ajustables
CATCH_RADIUS_METERS=25
POSITION_MAX_AGE_SECONDS=30
