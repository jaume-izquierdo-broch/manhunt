# Variables for docker-compose.yml. Copy to .env and change the secrets.
DB_USER=manhunt
DB_PASSWORD=manhunt_secret
DB_NAME=manhunt_db
REDIS_PASSWORD=redis_secret

# Ports on your machine. Change them if they're taken (e.g. by a Postgres
# inside WSL on 5432) and use the same port in DATABASE_URL / REDIS_PORT
# in apps/api/.env.
DB_PORT=5432
REDIS_PORT=6379

# Only for the "api" service (prod profile)
CORS_ORIGIN=*
API_PORT=3000
# Image to run on the server, e.g. ghcr.io/<owner>/manhunt-api:latest
API_IMAGE=manhunt-api:local
