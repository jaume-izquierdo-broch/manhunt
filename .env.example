# Variables para docker-compose.yml. Copia a .env y cambia los secretos.
DB_USER=manhunt
DB_PASSWORD=manhunt_secret
DB_NAME=manhunt_db
REDIS_PASSWORD=redis_secret

# Solo para el servicio "api" (perfil prod)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
CORS_ORIGIN=*
API_PORT=3000
# Imagen a usar en el servidor, p. ej. ghcr.io/<usuario>/manhunt-api:latest
API_IMAGE=manhunt-api:local
