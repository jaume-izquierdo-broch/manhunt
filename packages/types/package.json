{
  "name": "@manhunt/types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Contratos compartidos (DTOs, esquemas zod y eventos WebSocket) entre la API y la app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@manhunt/config-ts": "workspace:*",
    "typescript": "~6.0.3"
  }
}
